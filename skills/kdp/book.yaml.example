# KDP paperback metadata — fill in before running /kdp compose.
# Defaults below reflect 2026 bestseller patterns from a 500-book KDP analysis.
# See docs/coloring-book-market-signals.md for the data behind each default.
# Required fields are marked REQUIRED; everything else is optional.

# REQUIRED --------------------------------------------------------------
title: My Bold and Easy Garden Coloring Book
author: Jane Doe
trim_size: 8.5x11        # Known sizes: 5x8, 5.25x8, 5.5x8.5, 6x9, 6.14x9.21,
                         # 6.69x9.61, 7x10, 7.44x9.69, 7.5x9.25, 8x10,
                         # 8.25x6, 8.25x8.25, 8.5x8.5, 8.5x11, 8.27x11.69 (A4).
                         # 8.5x11 is 60-65% of top-selling coloring books.
paper: white             # white | cream | color-standard | color-premium

# OPTIONAL --------------------------------------------------------------
subtitle: 30 Bold and Easy Botanical Designs for Adults, Seniors, and Beginners
description: |
  A multi-paragraph description used as back-cover copy and as the Amazon
  product-page description. Keep the first sentence punchy — it's what shows
  in search results above the fold. Call out the bold-and-easy style, the
  marker-friendly thick lines, and the specific audience (seniors, beginners,
  low-vision, anxiety-relief) by name — specificity drove 4x the review count
  in the 500-book study.
language: English

# Interior layout — these control how /kdp compose builds interior.pdf.
single_sided: true       # KDP requires blank backing pages for coloring books so
                         # markers do not bleed through. The composer inserts a
                         # blank page after each image when true. Physical page
                         # count = 2 x image_count.
bleed: false             # 95% of adult coloring books use NO bleed with a 0.25"
                         # inner safe margin — buyers prefer the margin to grip
                         # the book without smudging. Set true only if your
                         # designs intentionally extend to the trim edge.

# Marketing — read by /kdp publish --draft to pre-fill the KDP Details step.
# Replace these with keywords that match your specific niche. Top-performing
# niche shapes (BSR under 100,000) include:
#   anxiety relief / mindfulness ($9.99, 142 avg reviews, BSR 47,300)
#   profession-specific — nurses, teachers, EMTs ($8.99, 134 reviews)
#   breed-specific pets — golden retrievers, bulldogs ($8.99, 98 reviews)
#   seasonal micro-niches — advent, Halloween-week ($7.99, 87 reviews)
#   cultural / heritage themes ($9.99, 76 reviews)
# Avoid "mandalas", "flowers", "animals" without a modifier — those cluster
# at BSR 290,000-310,000 with ~20 reviews.
keywords:
  - bold and easy coloring book
  - large print coloring book for seniors
  - stress relief coloring book
  - mindfulness coloring for adults
  - beginner coloring book thick lines
  - botanical coloring book adults
  - coloring book for low vision

categories:
  # BISAC codes — see https://www.bisg.org/complete-bisac-subject-headings-list
  # KDP accepts up to 3 categories per format, chosen in the dashboard (not
  # from BISAC directly since mid-2023). These values are retained for
  # reference and are not auto-set by /kdp publish — pick in the browser.
  - CRA001000              # Crafts & Hobbies / General
age_range: "14+"

# Pricing — one entry per marketplace. Read by /kdp publish --draft (not
# auto-filled on the KDP Pricing step; you set it in the browser).
# $9.99 USD unlocks the 60% royalty tier (below $9.99 = 50%); the June 2025
# royalty split makes $9.99 the rational default for every standard coloring
# book. Launch tactic: $7.99 for 4 weeks to build reviews, then raise to $9.99.
price_usd: 9.99
price_gbp: 7.99
price_eur: 8.99

# AI disclosure — required by KDP for any AI-generated content. Set honestly.
# Every image from /image-book is AI-generated, so images must be true.
ai_disclosure:
  text: false
  images: true
  translation: false

# Cover appearance (phase 1 generates a plain template cover you can replace
# with a hand-designed spread before upload). Bestseller covers use strong
# contrast, large sans-serif title typography, and a hero subject.
cover_bg_color: "#FFE066"     # Hex color for back cover + spine background.
cover_text_color: "#1A1A1A"   # Hex color for back-cover description text.

# Interior page count — overrides the auto-count. Usually leave commented;
# the composer derives physical page count from image_count × 2 (when
# single_sided=true). KDP minimum is 24 physical pages; the 2026 bestseller
# sweet spot is 40-60 physical pages (= 20-30 images at single_sided=true).
# Override only when you plan to insert front matter (title page, copyright,
# etc.) before upload.
# page_count: 60
