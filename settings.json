{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Edit(**)",
      "Write(**)",
      "Bash(*)",
      "mcp__context7__*",
      "mcp__claude_ai_Jedi-Knights_NWSL__*",
      "WebFetch",
      "Skill(update-config)"
    ],
    "deny": [],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Session started at $(date). Branch: $(git branch --show-current 2>/dev/null || echo 'N/A'). Last commit: $(git log --oneline -1 2>/dev/null || echo 'N/A').\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-main.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/ruff-format-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash(git push:*)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-main.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/conflict-check.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tdd-remind.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/sensitive-file-warn.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/lint.sh"
          }
        ]
      },
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/commit-msg.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-scan.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-stop.sh"
          },
          {
            "type": "command",
            "command": "echo \"If there is remaining work, keep going. Check your task list.\""
          },
          {
            "type": "command",
            "command": "echo \"If this session involved a correction or a repeated mistake, capture the guard before ending: update the relevant rule/skill/CLAUDE.md, and record repo-committed insights in LEARNINGS.md (per CLAUDE.md # Self-Improvement).\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "autoApprove": true
}
